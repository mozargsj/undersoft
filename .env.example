# Chave PUBLICA (site key) do widget Turnstile. Vazio = sem captcha (so para desenvolvimento).
VITE_TURNSTILE_SITE_KEY=

# URL do Worker que valida o token e reencaminha para o Formspree (ver worker/README.md).
# Vazio = envia direto para o Formspree (sem validacao do captcha no servidor).
VITE_CONTACT_ENDPOINT=
