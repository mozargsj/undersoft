:root{
      --bg:#ffffff;
      --bg-soft:#f6f7f8;
      --panel:#ffffff;
      --panel-2:#f2f3f5;
      --line:#e2e5e9;
      --text:#2e2420;
      --muted:#565f6a;
      --muted-2:#7f8994;
      --accent:#8fbf00;
      --accent-dark:#1d2604;
      --danger:#d63b3b;
      --max:1180px;
      --radius:18px;
      --shadow:0 18px 50px rgba(15,20,25,.08);
    }

    *{box-sizing:border-box}
    button, input, textarea, select{
      font-family: inherit;
    }
    html{scroll-behavior:smooth}
    body{
      margin:0;
      background: #fff;
      color:var(--text);
      font-family:"Geist", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height:1.6;
    }

    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}

    .container{
      width:min(calc(100% - 40px), var(--max));
      margin:0 auto;
    }

    .nav{
      position: relative;
      top:0;
      z-index:50;
      margin-bottom: -83px;
      margin-top: 10px;
      background: transparent;
      transition: background 0.4s ease, box-shadow 0.4s ease;
    }

    .nav.nav-fixed{
      position: fixed;
      left:0;
      width:100%;
      transition: all 0.8s ease;
    }

    .nav.nav-scrolled .nav-inner{
      background: #ffffffba;
      backdrop-filter: blur(8px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
        
    .nav.nav-scrolled .nav-links {
      color: #12151a;
    }

    .nav.nav-scrolled .bntcnheader {
      color: #fff;
      background: #ff5220;
    }

    .nav.nav-scrolled .lang-popup {
      background: #fff;
    }

    .nav.nav-scrolled .lang-option.is-selected {
      color: #fff;
      background: #ff5220;
    }

    .nav.nav-scrolled .lang-chevron {
      color: #12151a;
    }


    @keyframes navSlideIn{
      from{ transform: translateY(-100%); }
      to{ transform: translateY(0); }
    }

    .nav-scrolled .logounder {
      fill: #000;
    }

    .logounder {
      fill: #fff;
      width: 180px;
      transition: all 0.5s ease;
    }

    .stcntt {
      margin-left: 4px;
    }

    .nav-inner{
      min-height:72px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
      position: relative;
      padding: 0 15px;
      transition: all 0.5s ease;
      border-radius: 20px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      font-weight:800;
      letter-spacing:.04em;
    }

    .brand-mark{
      width:38px;
      height:38px;
      position:relative;
      isolation:isolate;
      display:grid;
      place-items:center;
      overflow:hidden;
      border:1.5px solid var(--accent);
      border-radius:11px;
      background:
        radial-gradient(
          circle at center,
          #11151a 0%,
          #11151a 54%,
          rgba(214,255,75,.035) 72%,
          rgba(214,255,75,.13) 100%
        );
      color:var(--accent);
      font-weight:900;
      line-height:1;
      text-shadow:
        0 0 5px rgba(214,255,75,.55),
        0 0 11px rgba(214,255,75,.24);
      box-shadow:
        0 0 0 1px rgba(214,255,75,.16),
        0 0 8px rgba(214,255,75,.26),
        0 0 18px rgba(143,191,0,.16),
        inset 0 0 10px rgba(214,255,75,.08);
    }

    .brand-mark::before{
      content:"";
      position:absolute;
      inset:-45%;
      z-index:-1;
      border-radius:50%;
      background:radial-gradient(
        circle,
        transparent 0 42%,
        rgba(214,255,75,.035) 62%,
        rgba(214,255,75,.15) 78%,
        transparent 100%
      );
      pointer-events:none;
    }

    .bntcnheader {
      color: #12151a;
      padding: 8px 16px;
      border-radius: 11px;
      background: #fff;
      font-weight: 400;
      transition: all 0.4s ease;
    }

    .bntcnheader:hover {
      box-shadow: 0 0 50px #ffffffd1;
    }

    .nav-links{
      position: relative;
      display: flex;
      align-items: center;
      gap: 24px;
      color: #ffffff;
      font-size: 1rem;
      padding: 10px 18px;
      border-radius: 11px;
      backdrop-filter: blur(18px);
      background: #ffffff00;
      box-shadow: inset 0 0px 10px #ffffff6e
    }

    .nav-links a{
      position: relative;
      z-index: 2;
      transition: color 0.4s ease;
    }

    .nav-indicator{
      position: absolute;
      top: 6px;
      bottom: 6px;
      left: 0;
      z-index: 1;
      border-radius: 8px;
      background: #ff5220;
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                  width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                  opacity 0.3s ease;
      pointer-events: none;
      opacity: 0;
    }

    .nav-indicator.is-visible{
      opacity: 1;
    }

    .nav-links a.active{
      color: #fff;
    }

    .nav-links a::before{
      content: '';
      position: absolute;
      top: -4px;
      bottom: -4px;
      left: -8px;
      right: -8px;
      border-radius: 8px;
      background-color: #fff;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
      z-index: -1;
    }

    .nav-links a:hover {
      color: #12151a;
    }

    .nav-links a:not(.active):hover::before{
      opacity: 1;
    }

    .nav-links .active {
      color: #fff !important;
    }

    .lang-switch{
      position: relative;
    }

    .lang-btn{
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border: none;
      border-radius: 11px;
      cursor: pointer;
      backdrop-filter: blur(18px);
      background: #ffffff17;
      box-shadow: inset 0 0px 10px #ffffff6e;
      transition: box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .lang-btn:hover{
      background-color: #ffffff4d;
    }

    .lang-flag{
      width:30px;
      height:30px;
      border-radius:3px;
      border-radius: 100px;
      overflow:hidden;
      display:block;
      flex-shrink:0;
      box-shadow: 0 0 0 1px rgba(0,0,0,.08);
    }

    .lang-flag svg{
      width:100%;
      height:100%;
      display:block;
    }

    .lang-flag img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .lang-chevron{
      font-size:.65rem;
      color: #fff;
      transition: transform 0.3s ease;
    }

    .lang-btn[aria-expanded="true"] .lang-chevron{
      transform: rotate(180deg);
    }

    .lang-popup{
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      min-width: 180px;
      border-radius: 14px;
      backdrop-filter: blur(18px);
      background: linear-gradient(to bottom, #ffffff63, #ffffffc2);
      border: 1px solid #ffffff4f;
      box-shadow: var(--shadow);
      padding: 6px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
      z-index: 60;
    }

    .lang-popup.is-open{
      opacity:1;
      visibility:visible;
      transform: translateY(0);
    }

    .lang-option{
      display:flex;
      align-items:center;
      gap:10px;
      width:100%;
      padding:9px 10px;
      border:none;
      background:transparent;
      border-radius:9px;
      font-size:.92rem;
      font-weight: 500;
      color: var(--text);
      cursor:pointer;
      text-align:left;
      transition: background 0.2s ease;
    }

    .lang-option:hover{
      background: var(--bg-soft);
    }

    .lang-check{
      margin-left:auto;
      font-size:.75rem;
      color: var(--accent-dark);
      opacity:0;
      transition: opacity 0.2s ease;
    }

    .lang-option.is-selected .lang-check{
      opacity:1;
    }

    .lang-option.is-selected{
      font-weight:600;
      background: var(--bg-soft);
    }

    @media (max-width: 860px){
      .lang-switch{ order: 3; }
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      min-height:48px;
      padding:0 20px;
      border-radius:12px;
      border:1px solid transparent;
      font-weight:500;
      transition:.2s ease;
      cursor:pointer;
    }


    .btn:disabled{
      opacity:.65;
      cursor:not-allowed;
      transform:none;
      filter:none;
    }

    .btn-primary {
      width: fit-content;
      display: flex;
      padding: 0.6em 1.3rem;
      cursor: pointer;
      gap: 0.4rem;
      font-weight: 500;
      border-radius: 12px;
      font-size: 1.1rem;
      background-color: #ff5220;
      background-size: 300%;
      color: #fff;
      border: none;
      background-position: left center;
      transition: all 0.4s ease;
}

.btn-primary:hover {
  background-size: 320%;
  background-position: right center;
  box-shadow: 0 0 60px #ff8e6db3;
}

    .btn-secondary{
        color: #12151a;
        background: #fff;
        transition: all 0.4s ease;
    }

    .btn-secondary:hover{  
      box-shadow: 0 0 50px #ffffff87;
    }

    .hero {
      display: flex;
      flex-direction: column;
      justify-content: start;
      align-items: center;
      padding: 22vh 0 76px;
      height: 100vh;
      position: relative;
      overflow: hidden;
      z-index: 1;
      will-change: transform;
    }

    @media screen and (max-height: 725px) {
      .hero {
        padding: 19vh 0 76px;
      }
    }

    .hero-grid{
      display: flex;
      gap: 56px;
      justify-content: center;
      align-items: center;
      text-align: center;
      transform-origin: center top;
      will-change: transform, filter, opacity;
    }

    .eyebrow{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 15px;
      backdrop-filter: blur(18px);
      background: linear-gradient(to bottom, #ffffff00, #ffffff40);
      border: 1px solid #ffffff4f;
      color: #ffffff;
      font-weight: 500;
      border-radius: 999px;
      font-size: .9rem;
      margin-bottom: 24px;
    }

    .dot{
      width:8px;
      height:8px;
      border-radius:50%;
      background:#fff;
    }

    h1,h2,h3,p{margin-top:0}

    h1 {
      font-size:max(3.5rem, min(3.8vw, 70px));
      line-height:.98;
      letter-spacing:-.055em;
      margin-bottom:24px;
      color: #fff;
    }

    .hero p{
      color:#ffffffeb;
      font-size:max(1.1rem, min(1.6vw, 20px));
      width: 85%;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 30px;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      justify-content: center;
      gap:14px;
      margin-bottom:54px;
    }

    .microcopy{
      color:var(--muted-2);
      font-size:.9rem;
    }

    .hero-card{
      background:linear-gradient(180deg, rgba(15,20,25,.025), rgba(15,20,25,.01));
      border:1px solid rgba(15,20,25,.08);
      border-radius:24px;
      padding:24px;
      box-shadow:var(--shadow);
    }

    .window-bar{
      display:flex;
      gap:7px;
      margin-bottom:20px;
    }

    .window-bar span{
      width:10px;
      height:10px;
      border-radius:50%;
      background:#c4cad1;
    }

    .flow{
      display:grid;
      gap:12px;
    }

    .flow-step{
      padding:16px;
      border:1px solid var(--line);
      background:var(--panel-2);
      border-radius:14px;
    }

    .flow-step strong{
      display:block;
      margin-bottom:4px;
    }

    .flow-step small{color:var(--muted)}
    .flow-arrow{text-align:center;color:var(--accent);font-size:1.3rem}

    section{
      padding:84px 0;
    }

    .section-head{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:30px;
      margin-bottom:38px;
    }

    #problema {
      padding: 20px 0;
    }

    .section-head h2{
      margin-bottom:0;
      font-size:clamp(2rem,4vw,3.4rem);
      letter-spacing:-.035em;
      max-width:760px;
      line-height:1.07;
    }

    .section-head p{
      color:var(--muted);
      max-width:520px;
      margin-bottom:2px;
    }

    .problem-grid,
    .service-grid,
    .benefit-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }

    .card{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:var(--radius);
      padding:24px;
      box-shadow:0 12px 30px rgba(0,0,0,.12);
    }

    .card-icon{
      width:42px;
      height:42px;
      border-radius:12px;
      display:grid;
      place-items:center;
      background:rgba(214,255,75,.08);
      border:1px solid rgba(214,255,75,.15);
      color:var(--accent);
      font-size:1.2rem;
      margin-bottom:18px;
    }

    .card h3{margin-bottom:10px}
    .card p{color:var(--muted);margin-bottom:0}

    .split{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:34px;
      align-items:start;
    }

    .compare{
      padding:26px;
      border-radius:var(--radius);
      border:1px solid var(--line);
      background:var(--panel);
    }

    .compare.bad{border-color:rgba(255,114,114,.22)}
    .compare.good{border-color:rgba(214,255,75,.25)}

    .compare ul{
      list-style:none;
      margin:18px 0 0;
      padding:0;
      display:grid;
      gap:12px;
    }

    .compare li{
      display:flex;
      gap:10px;
      color:var(--muted);
    }

    .compare.good li::before{content:"✓";color:var(--accent);font-weight:800}
    .compare.bad li::before{content:"×";color:var(--danger);font-weight:800}

    .timeline{
      display:grid;
      grid-template-columns:repeat(5,1fr);
      gap:14px;
    }

    .timeline-item{
      border:1px solid var(--line);
      border-radius:16px;
      padding:20px;
      background:var(--panel-2);
      position:relative;
    }

    .timeline-item span{
      display:inline-grid;
      place-items:center;
      width:34px;
      height:34px;
      border-radius:50%;
      background:var(--accent);
      color:#111;
      font-weight:900;
      margin-bottom:16px;
    }

    .timeline-item p{color:var(--muted);font-size:.94rem;margin-bottom:0}

    .offer{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:24px;
      align-items:stretch;
    }

    .offer-main{
      background:linear-gradient(135deg,rgba(214,255,75,.11),rgba(214,255,75,.025));
      border:1px solid rgba(214,255,75,.23);
      border-radius:24px;
      padding:34px;
    }

    .offer-main h2{
      font-size:clamp(2rem,4vw,3.2rem);
      line-height:1.08;
      letter-spacing:-.035em;
    }

    .offer-main p{color:var(--muted);max-width:680px}


    .case{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:24px;
      padding:30px;
    }

    .case-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
      margin-top:24px;
    }

    .metric{
      background:var(--panel-2);
      border:1px solid var(--line);
      border-radius:14px;
      padding:18px;
    }

    .metric-head{
      display:flex;
      align-items:center;
      gap:14px;
      margin-bottom:16px;
    }

    .metric-icon{
      width:64px;
      height:64px;
      flex:0 0 64px;
      object-fit:contain;
      user-select:none;
      pointer-events:none;
      filter:
        drop-shadow(0 0 8px rgba(214,255,75,.20))
        drop-shadow(0 0 18px rgba(214,255,75,.10));
    }

    .metric strong{
      display:block;
      color:var(--accent);
      font-size:1.25rem;
      line-height:1.2;
      margin:0;
      text-shadow:
        0 0 10px rgba(214,255,75,.10);
    }

    .metric span{
      display:block;
      color:var(--muted);
      font-size:.92rem;
      line-height:1.7;
    }

    .metric .case-highlight{
      color:var(--accent);
      font-weight:800;
    }

    .cta{
      text-align:center;
      padding:74px 30px;
      background:
        radial-gradient(circle at 50% 0%, rgba(214,255,75,.16), transparent 42%),
        var(--panel);
      border:1px solid var(--line);
      border-radius:28px;
    }

    .cta h2{
      font-size:clamp(2.2rem,5vw,4.2rem);
      line-height:1.03;
      letter-spacing:-.05em;
      max-width:820px;
      margin-left:auto;
      margin-right:auto;
    }

    .cta p{
      color:var(--muted);
      max-width:620px;
      margin:0 auto 28px;
    }


    .contact-layout{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:24px;
      align-items:stretch;
    }

    .contact-form-card,
    .contact-info-card{
      background:var(--panel);
      border:1px solid var(--line);
      border-radius:24px;
      padding:30px;
      box-shadow:0 12px 30px rgba(0,0,0,.12);
    }

    .contact-form-card h2,
    .contact-info-card h3{
      margin-bottom:12px;
    }

    .contact-form-card > p,
    .contact-info-card > p{
      color:var(--muted);
    }

    .contact-form{
      display:grid;
      gap:18px;
      margin-top:26px;
    }

    .form-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:16px;
    }

    .form-group{
      display:grid;
      gap:8px;
    }

    .form-group.full{
      grid-column:1 / -1;
    }

    .form-group label{
      color:var(--text);
      font-size:.92rem;
      font-weight:700;
    }

    .form-group input,
    .form-group textarea,
    .form-group select{
      width:100%;
      border:1px solid var(--line);
      background:var(--panel-2);
      color:var(--text);
      border-radius:12px;
      padding:14px 15px;
      font:inherit;
      outline:none;
      transition:border-color .2s ease, box-shadow .2s ease;
    }

    .form-group textarea{
      min-height:160px;
      resize:vertical;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder{
      color:var(--muted-2);
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus{
      border-color:rgba(214,255,75,.65);
      box-shadow:0 0 0 4px rgba(214,255,75,.08);
    }

    .consent{
      display:flex;
      align-items:flex-start;
      gap:10px;
      color:var(--muted);
      font-size:.88rem;
    }

    .consent input{
      margin-top:4px;
      accent-color:var(--accent);
    }

    .form-note{
      color:var(--muted-2);
      font-size:.84rem;
      margin:0;
    }

    .form-status{
      display:none;
      padding:12px 14px;
      border-radius:12px;
      border:1px solid rgba(214,255,75,.22);
      background:rgba(214,255,75,.06);
      color:#ddff74;
      font-size:.9rem;
    }

    .contact-list{
      display:grid;
      gap:14px;
      margin-top:26px;
    }

    .contact-item{
      display:flex;
      align-items:center;
      gap:14px;
      padding:16px;
      border:1px solid var(--line);
      background:var(--panel-2);
      border-radius:14px;
      transition:.2s ease;
    }

    .contact-item:hover{
      border-color:rgba(214,255,75,.32);
      transform:translateY(-2px);
    }

    .contact-icon{
      flex:0 0 auto;
      width:42px;
      height:42px;
      border-radius:12px;
      display:grid;
      place-items:center;
      background:rgba(214,255,75,.08);
      border:1px solid rgba(214,255,75,.15);
      color:var(--accent);
      font-weight:900;
    }

    .contact-item strong{
      display:block;
      margin-bottom:2px;
    }

    .contact-item span{
      color:var(--muted);
      font-size:.9rem;
    }

    .contact-divider{
      height:1px;
      background:var(--line);
      margin:26px 0;
    }

    .contact-info-card .btn{
      width:100%;
    }

    .honeypot{
      position:absolute !important;
      left:-9999px !important;
      width:1px !important;
      height:1px !important;
      overflow:hidden !important;
    }


    .success-modal{
      position:fixed;
      inset:0;
      z-index:1000;
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
      background:rgba(5,7,9,.78);
      backdrop-filter:blur(8px);
    }

    .success-modal.is-visible{
      display:flex;
    }

    .success-modal-card{
      width:min(100%, 460px);
      padding:30px;
      text-align:center;
      background:var(--panel);
      border:1px solid rgba(214,255,75,.28);
      border-radius:22px;
      box-shadow:var(--shadow);
    }

    .success-modal-icon{
      width:58px;
      height:58px;
      margin:0 auto 18px;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:var(--accent);
      color:var(--bg);
      font-size:1.65rem;
      font-weight:900;
    }

    .success-modal-card h3{
      margin-bottom:10px;
    }

    .success-modal-card p{
      color:var(--muted);
      margin-bottom:22px;
    }

    .success-modal-card .btn{
      min-width:120px;
    }


    .success-dialog{
      width:min(calc(100% - 32px), 460px);
      padding:0;
      color:var(--text);
      background:transparent;
      border:0;
      border-radius:22px;
    }

    .success-dialog::backdrop{
      background:rgba(5,7,9,.82);
      backdrop-filter:blur(8px);
    }

    .success-dialog-card{
      padding:30px;
      text-align:center;
      background:var(--panel);
      border:1px solid rgba(214,255,75,.28);
      border-radius:22px;
      box-shadow:var(--shadow);
    }

    .success-dialog-icon{
      width:58px;
      height:58px;
      margin:0 auto 18px;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:var(--accent);
      color:var(--bg);
      font-size:1.65rem;
      font-weight:900;
    }

    .success-dialog-card h3{
      margin-bottom:10px;
    }

    .success-dialog-card p{
      color:var(--muted);
      margin-bottom:22px;
    }

    .success-dialog-card .btn{
      min-width:120px;
    }

    footer{
      padding:36px 0;
      color:var(--muted-2);
      font-size:.9rem;
    }

    .footer-inner{
      display:flex;
      justify-content:space-between;
      gap:24px;
      align-items:center;
      flex-wrap:wrap;
    }

    .mobile-menu{display:none}

    @media (max-width: 980px){
      .hero-grid,.split,.offer,.contact-layout{grid-template-columns:1fr}
      .problem-grid,.service-grid,.benefit-grid{grid-template-columns:repeat(2,1fr)}
      .timeline{grid-template-columns:repeat(2,1fr)}
      .section-head{align-items:start;flex-direction:column}
    }

    @media (max-width: 720px){
      .nav-links{display:none}
      .mobile-menu{display:inline-flex}
      .hero{padding-top:72px}
      .problem-grid,.service-grid,.benefit-grid,.timeline,.case-grid,.form-grid{grid-template-columns:1fr}
      .container{width:min(calc(100% - 28px), var(--max))}
      .hero-actions{flex-direction:column}
      .btn{width:100%}
      section{padding:64px 0}
      .price-box{min-height:240px}
    }
    
    .bg-wrapper {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      overflow: hidden;
      background: #000;
}

.pulse-img {
    position: absolute;
    z-index: -1;
    width: 100%;
}

.hero-title {
    font-weight: 800;
    line-height: 1.15;
  }

  /* cada .hero-title-line é um bloco próprio, forçando a quebra sempre
     no mesmo ponto ("processos sem" / "jogar fora o que já funciona."),
     independente da largura da palavra rotativa. */
  .hero-title-line {
    display: block;
  }

  .hero-title-line + .hero-title-line {
    display: block;
  }

  /* bloco da palavra digitada: sem largura fixa, o texto simplesmente
     cresce/encolhe conforme o JS digita e apaga (efeito máquina de escrever) */
  .rotator {
    display: inline-flex;
    align-items: center;
    vertical-align: bottom;
    background: #ffffff;
    padding: 0 10px;
    margin-right: 10px;
    border-radius: 10px;
  }

  .typed-word {
    white-space: nowrap;
    color: #ff5220;
  }

  .typed-cursor {
    display: inline-block;
    width: 5px;
    height: 0.85em;
    margin-left: 6px;
    background: #ff5220;
    animation: typed-blink 0.8s step-end infinite;
  }

  @keyframes typed-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .typed-cursor {
      animation: none;
    }
  }

/* From Uiverse.io by mrhyddenn */ 
.scrolldown {
  --color: white;
  --sizeX: 20px;
  --sizeY: 40px;
  position: relative;
  width: var(--sizeX);
  height: var(--sizeY);
  margin-left: auto;
  margin-right: auto;
  border: calc(var(--sizeX) / 10) solid var(--color);
  border-radius: 50px;
  box-sizing: border-box;
  margin-bottom: 16px;
  cursor: pointer;
}

.scrolldown::before {
  content: "";
  position: absolute;
  bottom: 25px;
  left: 50%;
  width: 6px;
  height: 6px;
  margin-left: -3px;
  background-color: var(--color);
  border-radius: 100%;
  animation: scrolldown-anim 2s infinite;
  box-sizing: border-box;
  box-shadow: 0px -5px 3px 1px #ff522085;
}

@keyframes scrolldown-anim {
  0% {
    opacity: 0;
    height: 6px;
  }

  40% {
    opacity: 1;
    height: 10px;
  }

  80% {
    transform: translate(0, 20px);
    height: 10px;
    opacity: 0;
  }

  100% {
    height: 3px;
    opacity: 0;
  }
}

.chevrons {
  padding: 6px 0 0 0;
  margin-left: -2px;
  margin-top: 48px;
  width: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.chevrondown {
  margin-top: -6px;
  position: relative;
  border: solid var(--color);
  border-width: 0 3px 3px 0;
  display: inline-block;
  width: 10px;
  height: 10px;
  transform: rotate(45deg);
}

.chevrondown:nth-child(odd) {
  animation: pulse54012 500ms ease infinite alternate;
}

.chevrondown:nth-child(even) {
  animation: pulse54012 500ms ease infinite alternate 250ms;
}

@keyframes pulse54012 {
  from {
    opacity: 0;
  }

  to {
    opacity: 0.5;
  }
}

.btnidm {
    display: flex;
    align-items: center;
    gap: 2rem;
}
/* ===== Page Loader ===== */
.page-loader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  background: linear-gradient(322deg, #ffbeaa, #ffffff, #ffd3c5);
  transition: opacity 0.4s ease, visibility 0.4s ease;
}

.page-loader.is-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

/* Trava o rolamento da página enquanto o loader estiver visível.
   Aplicada no <html> via JS (classe .is-loading) e removida assim que
   o loader termina. O loader já cobre a tela inteira com seu próprio
   fundo (gradiente), então travar o scroll aqui não deixa nada em
   branco, só impede o usuário de rolar por trás dele. */
html.is-loading,
html.is-loading body {
  overflow: hidden;
  height: 100%;
}

.loader-ring-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loader-ring {
  position: relative;
  width: 115px;
  height: 115px;
  transform: rotate(-90deg); /* começa do topo, preenche em sentido horário */
}

.loader-ring-track {
  fill: none;
  stroke: rgba(0, 0, 0, 0.1);
  stroke-width: 6;
}

.loader-ring-fill {
  fill: none;
  stroke: #ff5220;
  stroke-width: 6;
  stroke-linecap: round;
  stroke-dasharray: 213.6; /* 2 * PI * r (r=34) */
  stroke-dashoffset: 213.6;
  /* Sem transição fixa aqui: o requestAnimationFrame já entrega valores
     suaves quadro a quadro durante o carregamento. A transição de
     conclusão (até 100%) é ativada via JS só na hora de finalizar. */
}

.loader-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 50px;
  height: auto;
  transform: translate(-50%, -50%);
  transform-origin: center;
  pointer-events: none;
  animation: loader-icon-pulse 1.1s ease-in-out infinite;
}

@keyframes loader-icon-pulse {
  0%, 100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.15);
    opacity: 0.85;
  }
}

@media (prefers-reduced-motion: reduce) {
  .loader-icon {
    animation: none;
  }
}

.loader-percent {
  font-family: "Geist", sans-serif;
  font-size: 1.5rem;
  font-weight: bold;
  color: rgb(0 0 0);
  letter-spacing: 0.02em;
  min-width: 3ch;
  text-align: center;
}

/* ==========================================
   ESTILOS COMPLETOS DA DEMONSTRAÇÃO
   ========================================== */

.demo-ma-wrapper {
    --demo-ma-border-color: #e2e8f0;
    --demo-ma-text-muted: #64748b;
    --demo-ma-error-color: #ef4444;
    --demo-ma-error-bg: #fef2f2;
    --demo-ma-auto-color: #10b981;
    --demo-ma-auto-bg: #ecfdf5;
    --demo-ma-manual-color: #f59e0b;
    --demo-ma-manual-bg: #fffbeb;
    --demo-ma-cell-bg: #ffffff;
    --demo-ma-cell-active: #f1f5f9;
    color: var(--demo-ma-text-main);
    margin-bottom: 80px;
    box-sizing: border-box;
    width: 100%;
}

.demo-ma-wrapper * { 
    box-sizing: border-box; 
}

/* Cabeçalho */
.demo-ma-header { 
    text-align: center; 
    margin-bottom: 40px; 
}
.demo-ma-header h1 { 
    font-size: 2.6rem; 
    font-weight: 700; 
    margin-bottom: 12px; 
    letter-spacing: -0.5px; 
}
.demo-ma-header p { 
    color: #2e2420b5; 
    font-size: 1.3rem; 
}

/* Layout dos Painéis */
.demo-ma-container {
    position: relative;
    display: flex;
    align-items: stretch;
    justify-content: right;
    gap: 20px;
    width: 100%;
    margin: 0 auto;
}

.demo-ma-connector {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 710px;
    height: 450px;
    transform: translate(-50%, -50%);
    border-radius: 80px;
    border: 3px solid #ff5220;
    background: #fff;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 45%, transparent 65%);
    mask-image: linear-gradient(to right, #000 0%, #000 45%, transparent 65%);
}
.demo-ma-connector-star-icon {
    color: #ff5220;
    font-size: 16px;
}

/* Círculo sólido com estrela, fixo na borda esquerda do container,
   centralizado verticalmente. Fica acima do .demo-ma-connector (que é
   só o traçado pontilhado) e acima do stack de painéis, então nunca
   fica escondido atrás de nada. */
.demo-ma-star-badge {
    position: absolute;
    top: 50%;
    left: 20%;
    width: 250px;
    height: 250px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #ff5220;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
}

.logoudnr {
    width: 120px;
    fill: #fff;
}
.demo-ma-star-badge i {
    color: #fff;
    font-size: 20px;
}

/* Coluna direita: os dois painéis, um sobre o outro */
.demo-ma-panels-stack {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 25px;
    width: 100%;
    max-width: 620px;
    justify-content: right;
}

.demo-ma-system-panel {
    width: 100%;
    height: auto; /* altura fixa: o painel nunca mais expande quando o
                       resumo aparece — o resumo passa a ser um popup
                       sobreposto, não um item que empurra layout */
    background: #f5f5f5; 
    border-radius: 17px; 
    padding: 24px; 
    position: relative; 
    overflow: hidden; 
    display: flex; 
    flex-direction: column; 
    gap: 20px;
}
.demo-ma-panel-archaic { 
    background: #fbf2f2;
}
.demo-ma-panel-modern { 
    background: #e4f1ed;
}

.grencrt {
  color: #fff;
  background: #08cb8a !important;
}

/* Painel Cabeçalho */
.demo-ma-panel-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: flex-start; 
}
.demo-ma-panel-header h2 { 
    font-size: 1.4rem; 
    font-weight: 600; 
    margin-bottom: 8px; 
    margin-top: 0; 
}

/* Timers e Badges */
.demo-ma-timer-box { 
    text-align: right; 
    color: #fff;
    background: #ff0000;
    padding: 8px 17px; 
    border-radius: 8px; 
    line-height: 1.3;
}
.demo-ma-timer-label { 
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: bold; 
}
.demo-ma-timer {  
    font-size: 1.25rem; 
    font-weight: bold; 
}
.demo-ma-timer-green { 
    color: #fff; 
}

.demo-ma-status-badge { 
    display: inline-block; 
    font-size: 0.75rem; 
    padding: 4px 10px; 
    border-radius: 7px; 
}
.demo-ma-badge-manual { 
    background: #ff000024;
    color: #870000;
}
.demo-ma-badge-auto { 
    background: #08cb8a2b;
    color: #047857;
}

/* Notificações (Toasts) */
.demo-ma-toast {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    text-align: center;
    position: absolute;
    top: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(25%);
    z-index: 50;
    pointer-events: none;
    width: 80%;
}
.demo-ma-toast.show { 
    opacity: 1; 
    transform: translateX(-50%) translateY(25%); 
}
.demo-ma-toast-success { 
    background-color: #08cb8a;
    color: #fff;
}

.checkdmee {
    font-size: 1.4rem;
}
.demo-ma-toast-error { 
    background-color: #ff0000; 
    color: #fff; 
}

/* Tabelas e Células */
.demo-ma-table-wrapper { 
    border-radius: 8px; 
    overflow: hidden; 
}
.demo-ma-spreadsheet { 
    width: 100%; 
    border-collapse: collapse; 
    font-size: 0.95rem; 
}
.demo-ma-spreadsheet th, 
.demo-ma-spreadsheet td { 
    border: 1px solid var(--demo-ma-border-color); 
    padding: 12px 16px; 
    text-align: left; 
    width: 33.33%; 
    height: 48px; 
}
.demo-ma-spreadsheet th { 
    background-color: #f8fafc; 
    font-weight: 600; 
    color: var(--demo-ma-text-muted); 
    font-size: 0.85rem; 
}
.demo-ma-spreadsheet td { 
    background-color: var(--demo-ma-cell-bg); 
    transition: all 0.2s; 
    position: relative; 
    font-variant-numeric: tabular-nums; 
}

/* Cursor Simulado e Estados Manuais */
.demo-ma-cursor {
    width: 24px; 
    height: 24px;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="%231e293b" stroke="%23ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/></svg>');
    background-size: contain; 
    background-repeat: no-repeat;
    position: absolute; 
    top: 0px; 
    left: 40px; 
    z-index: 100;
    transition: all 0.4s ease-out; 
    pointer-events: none; 
    opacity: 0; 
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
}
.demo-ma-cell-active-manual { 
    background-color: var(--demo-ma-cell-active) !important; 
    box-shadow: inset 0 0 0 2px #3b82f6; 
}
.demo-ma-cell-error-highlight { 
    background-color: var(--demo-ma-error-bg) !important; 
    color: var(--demo-ma-error-color); 
    box-shadow: inset 0 0 0 2px var(--demo-ma-error-color); 
    animation: demo-ma-shake 0.4s; 
}

/* Estados Automáticos */
.demo-ma-cell-success { 
    background-color: var(--demo-ma-auto-bg) !important; 
    color: #065f46; 
    animation: demo-ma-flash-green 0.8s ease-out; 
}

/* Animações */
@keyframes demo-ma-flash-green { 
    0% { background-color: #a7f3d0; } 
    100% { background-color: var(--demo-ma-auto-bg); } 
}
@keyframes demo-ma-shake { 
    0%, 100% { transform: translateX(0); } 
    25%, 75% { transform: translateX(-4px); } 
    50% { transform: translateX(4px); } 
}
.demo-ma-typing-cursor::after { 
    content: '|'; 
    font-weight: normal; 
    color: #3b82f6; 
    animation: demo-ma-blink 0.8s step-end infinite; 
}
@keyframes demo-ma-blink { 
    50% { opacity: 0; } 
}

/* Fechamento Financeiro (Sumários) */
.demo-ma-summary {
    /* Popup: fica fora da tela (embaixo) por padrão e sobe por cima do
       conteúdo do painel quando ativado — nunca é um item de fluxo, por
       isso não empurra a altura de .demo-ma-system-panel. O painel já é
       position:relative + overflow:hidden, então serve de limite exato:
       o popup nunca aparece fora dele nem sobra espaço vazio. */
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: calc(100% - 24px);
    overflow-y: auto;
    opacity: 0;
    transform: translateY(100%);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
    pointer-events: none;
    z-index: 2;
}
.demo-ma-summary-inner {
    width: 93%;
    margin: 0 auto 20px;
    color: white;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.08);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 0;
}

.dmverd {
    color: white;
    background: #08cb8a;
}

.dmred {
    color: white;
    background: #ff0000;
}

.demo-ma-summary.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
}
.demo-ma-summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 1rem;
    color: var(--demo-ma-text-main);
}

.dmverd strong {
  color: #0a4936;
}
.demo-ma-summary-alert {
    background-color: #0000003d;
    color: #ffffff;
    padding: 7px;
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.4;
}
.demo-ma-summary-success {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    margin-top: 7px;
    background-color: #00000033;
    color: #ffffff;
    padding: 7px;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 500;
}
.demo-ma-summary-loss { 
    background-color: #f8fafc00; 
}
.demo-ma-summary-profit { 
    background-color: #f8fafc00; 
}
.demo-ma-green-text { 
    color: #fff !important;
    font-size: 1.15rem; 
}